# Postgres connection string (Supabase pooled connection, port 6543)
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection for migrations (Supabase direct, port 5432)
DIRECT_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres"

# Timezone for displayed dates
TZ="Asia/Kuala_Lumpur"

# Optional login gate. Set this to enable the password screen; leave it unset
# and the app stays open to anyone with the URL.
APP_PASSWORD=""

# Optional. Signs the session cookie. If empty, a key is derived from
# APP_PASSWORD. Set a long random string so sessions survive password changes.
AUTH_SECRET=""
